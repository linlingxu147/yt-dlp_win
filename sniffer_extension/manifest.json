{
    "manifest_version": 3,
    "name": "yt-dlp 网页视频嗅探",
    "version": "1.6.1",
    "key": "",
    "description": "嗅探网页中正在播放的视频/音频（网络响应 + 页面请求钩子 + 页面元素），一键交给本机 yt-dlp Web 服务下载。原理借鉴 FileCentipede 扩展。",
    "permissions": [
        "webRequest",
        "storage",
        "contextMenus",
        "cookies",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "yt-dlp 嗅探：点我打开/收起本页嗅探面板"
    },
    "icons": {
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["injected.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "ISOLATED"
        }
    ]
}
